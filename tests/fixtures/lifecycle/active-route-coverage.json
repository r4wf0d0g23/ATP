{
  "schema_version": "1.0.0",
  "description": "Sanitized one-to-one behavioral models for the ten active reference-instance routes.",
  "routes": [
    {"id":"route-01","required_vars":["plugin-state"],"tools":["filesystem","command"],"checkpoint_mode":"rollback-and-stop","steps":[{"tool":"command","operation":"validate-plugin"},{"tool":"filesystem","operation":"write","target":"/sandbox/plugin.json","value":{"enabled":true}}]},
    {"id":"route-02","required_vars":["review-state"],"tools":["filesystem"],"checkpoint_mode":"commit-and-stop","steps":[{"tool":"filesystem","operation":"write","target":"/sandbox/review.json","value":{"status":"reviewed"}}]},
    {"id":"route-03","required_vars":["conversation-state"],"tools":["production-readonly"],"checkpoint_mode":"write-handoff-artifact","steps":[{"tool":"production-readonly","operation":"read","target":"fixture://conversation/context"}]},
    {"id":"route-04","required_vars":["release-state","package-state"],"tools":["command","endpoint","filesystem"],"checkpoint_mode":"rollback-and-stop","steps":[{"tool":"command","operation":"build"},{"tool":"endpoint","operation":"get","target":"fixture://release/health"},{"tool":"filesystem","operation":"write","target":"/sandbox/release.json","value":{"staged":true}}]},
    {"id":"route-05","required_vars":["crew-state"],"tools":["production-readonly"],"checkpoint_mode":"write-handoff-artifact","steps":[{"tool":"production-readonly","operation":"read","target":"fixture://crew/status"}]},
    {"id":"route-06","required_vars":["peer-state","crew-state"],"tools":["endpoint"],"checkpoint_mode":"write-handoff-artifact","steps":[{"tool":"endpoint","operation":"post","target":"fixture://peer/message"}]},
    {"id":"route-07","required_vars":["compute-state"],"tools":["command","production-readonly"],"checkpoint_mode":"rollback-and-stop","steps":[{"tool":"production-readonly","operation":"read","target":"fixture://compute/status"},{"tool":"command","operation":"simulate-restart"}]},
    {"id":"route-08","required_vars":["memory-state"],"tools":["filesystem"],"checkpoint_mode":"commit-and-stop","steps":[{"tool":"filesystem","operation":"write","target":"/sandbox/memory.json","value":{"compacted":true}}]},
    {"id":"route-09","required_vars":["config-state"],"tools":["command","filesystem"],"checkpoint_mode":"rollback-and-stop","steps":[{"tool":"command","operation":"validate-config"},{"tool":"filesystem","operation":"write","target":"/sandbox/config.json","value":{"validated":true}}]},
    {"id":"route-10","required_vars":["router-state","worker-state"],"tools":["production-readonly","endpoint"],"checkpoint_mode":"write-handoff-artifact","steps":[{"tool":"production-readonly","operation":"read","target":"fixture://router/index"},{"tool":"endpoint","operation":"dispatch","target":"fixture://worker/run"}]}
  ]
}
